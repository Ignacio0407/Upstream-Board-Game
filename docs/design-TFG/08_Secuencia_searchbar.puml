@startuml
autonumber
skinparam shadowing false
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    ParticipantBorderColor #2C3E50
    ParticipantBackgroundColor #ECF0F1
}

title Ciclo de Vida de Búsqueda Reactiva (SearchBar con Memoria a 3 Niveles)

actor "Usuario" as U
participant "SearchBar (Vista)" as SB
participant "useSearchEngine (Hook)" as Hook
participant "LRU Cache (Memoria L3)" as Cache
participant "searchEngine (Core)" as Engine
participant "ListGenerator (Padre)" as LG

== Nivel 1: Memoria Volátil (Estado Local y Debounce) ==

U -> SB: Teclea caracteres (e.g. "name:Ignacio")
SB -> SB: setSearchTerm("name:Ignacio")
note right: Nivel 1: Estado inmediato del input (React State)

loop Durante debounceMs (300ms)
    U -> SB: Sigue tecleando...
    SB -> SB: Reiniciar Timer (Debounce)
end

... 300ms de inactividad ...

SB -> SB: Ejecuta useEffect (Timer expira)
SB -> Hook: search("name:Ignacio")
activate Hook

== Nivel 2: Memoria de Acceso Rápido (LRU Cache) ==

Hook -> Hook: Generar cacheKey\nJSON.stringify({query, options})
Hook -> Cache: get(cacheKey)
activate Cache

alt Cache Hit (Nivel 2)
    Cache --> Hook: Retorna [Resultados Cached]
    note right: Recuperación instantánea sin procesamiento
else Cache Miss
    Cache --> Hook: undefined
    deactivate Cache
    
    == Nivel 3: Memoria de Cómputo (Motor de Búsqueda) ==
    
    Hook -> Engine: searchData(data, query, options)
    activate Engine
    
    Engine -> Engine: parseSearchQuery(query)
    note right: Extracción de atributos (name) y valores (Ignacio)
    
    loop Para cada item en data
        Engine -> Engine: getNestedValue(item, "name")
        Engine -> Engine: normalize/prepare()
        Engine -> Engine: compare(haystack, needle, mode)
    end
    
    Engine --> Hook: [Nuevos Resultados]
    deactivate Engine
    
    Hook -> Cache: set(cacheKey, resultados)
    note left: Actualiza LRU (desalojando lo más antiguo)
end

Hook --> SB: results
deactivate Hook

SB -> LG: setFiltered(results)
note right: Propagación de datos filtrados al componente padre

LG -> LG: Re-renderizar Lista
U <-- LG: Visualiza resultados filtrados

@enduml

@startuml
autonumber
skinparam shadowing false
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    ParticipantBorderColor #2C3E50
    ParticipantBackgroundColor #ECF0F1
}

title Motor de Juego: Flujo de Movimiento y Notificaciones (WebSockets)

actor "Jugador Actual" as U
participant "Frontend (React)" as FE
participant "SalmonMatchController" as SMC
participant "SalmonMatchService" as SMS
participant "PlayerService" as PS
participant "MatchTileService" as MTS
participant "SimpMessagingTemplate" as STOMP
participant "Otros Jugadores (React)" as OFE

U -> FE: Arrastrar/Clicar Salmón
FE -> SMC: updateCoordinate(id, newCoord)
activate SMC

SMC -> SMS: updateCoordinate(id, newCoord)
activate SMS

== Fase 1: Validación y Coste de Energía ==

SMS -> SMS: throwExceptionsInitial()
note right: Valida turno, energía > 0\ny destino válido.

alt Movimiento desde el Mar (Sea)
    SMS -> SMS: fromSea()
else Movimiento en el Río (River)
    SMS -> SMS: fromGrid() / fromGridFull()
    note right: Cálculo de energía y salto\nsegún tipo de casilla.
end

== Fase 2: Gestión de Obstáculos ==

alt Casilla con Oso (BEAR) / Salto
    SMS -> SMS: salmonMatch.setSalmonsNumber(n - 1)
else Casilla con Águila (EAGLE)
    SMS -> MTS: eagleToWater()
end

== Fase 3: Procesamiento y Sincronización ==

SMS -> SMS: processSalmonMovement()
activate SMS #DarkGray

SMS -> PS: save(player)
note right: Se descuenta la energía gastada.

alt Player Energy == 0
    note over SMS, MTS: Lógica de Garzas (Fin de Turno)
    SMS -> SMS: herons(player, match)
    loop Para cada casilla con Garza (HERON)
        SMS -> SMS: Eliminación selectiva de salmones
        SMS -> MTS: update(heron)
    end
    SMS -> STOMP: convertAndSend("/topic/herons/...")
end

SMS -> STOMP: convertAndSend("/topic/movingSalmon/...", payload)
note right: Notifica movimiento y estado de tiles\na todos los jugadores suscritos.

deactivate SMS

SMS --> SMC: (void)
deactivate SMS
SMC --> FE: 200 OK
deactivate SMC

== Fase 4: Sincronización y Re-renderizado ==

STOMP -> FE: Mensaje WebSocket (TOPIC)
STOMP -> OFE: Mensaje WebSocket (TOPIC)

FE -> FE: Re-renderizar Tablero (React state update)
OFE -> OFE: Re-renderizar Tablero (React state update)

note bottom
  **Nota de Arquitectura:** El controlador es "lean" (ligero) y devuelve 200 OK sin cuerpo.
  Toda la actualización del estado visual del tablero se gestiona de forma
  reactiva mediante WebSockets (STOMP) para garantizar la consistencia global.
  Ambos clientes ven el cambio simultáneamente sin recargar la página.
end note

@enduml
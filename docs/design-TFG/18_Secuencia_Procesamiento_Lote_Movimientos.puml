@startuml
autonumber
skinparam shadowing false
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    ParticipantBorderColor #2C3E50
    ParticipantBackgroundColor #ECF0F1
}

title Procesamiento de Movimientos en Lote (Batch Movement Paradigm)

actor "Jugador Actual" as Player
participant "Game.tsx" as View
participant "calculateValidMoves" as MoveCalculator
participant "SalmonMatchController" as Controller
participant "SalmonMatchService" as ServiceLayer
participant "Repositorios JPA" as Repositories
participant "SimpMessagingTemplate" as StompBroker
participant "Clientes Suscritos" as RemoteClients

== 1. Selección y Acumulación de Acciones en Cliente ==

Player -> View: Clic en salmón activo
View -> MoveCalculator: calculateValidMoves(salmon, grid, energy, playersNumber)
activate MoveCalculator
MoveCalculator --> View: validMoves: ValidMove[]
deactivate MoveCalculator

View -> View: Resaltar casillas válidas en la cuadrícula

loop Para cada paso del turno (hasta agotar energía o confirmar)
    Player -> View: Clic en celda destino válida
    View -> View: Registrar paso en cola de lote y actualizar vista previa en memoria
    note right of View
      Se acumulan los movimientos y snapshots en memoria (Undo/Redo local)
      descontando energía visual sin invocar al servidor hasta confirmar.
    end note
end

== 2. Envío Consolidado del Turno ==

Player -> View: Pulsa "Confirmar Turno"
View -> View: setConfirmBatchIsSubmitting(true)

View -> Controller: PATCH /api/v1/salmonMatches/move-batch/{matchId}\n[Payload: List<MoveRequest>]
activate Controller

Controller -> ServiceLayer: updateCoordinateBatch(matchId, moves)
activate ServiceLayer

== 3. Validación y Mutación en Servidor ==

loop Para cada MoveRequest de la lista
    ServiceLayer -> ServiceLayer: Validar reglas de casilla, coste y amenazas
    note right of ServiceLayer
      Detalle exhaustivo de las reglas de movimiento
      y amenazas se modela en el diagrama de flujo 08.
    end note
    ServiceLayer -> ServiceLayer: Actualizar coordenadas de salmón y restar energía
end

opt Saldo de energía del jugador == 0
    ServiceLayer -> ServiceLayer: Procesar amenazas de Garzas (herons)
end

== 4. Persistencia Atómica en Base de Datos ==

ServiceLayer -> Repositories: playerRepository.save(player)
ServiceLayer -> Repositories: salmonMatchRepository.saveAll(salmons)
ServiceLayer -> Repositories: matchTileRepository.saveAll(matchTiles)

ServiceLayer -> StompBroker: convertAndSend("/topic/tilesAndSalmons/" + matchId, payload)
ServiceLayer -> StompBroker: convertAndSend("/topic/players/" + matchId, playersPayload)

ServiceLayer --> Controller: void
deactivate ServiceLayer

Controller --> View: 200 OK
deactivate Controller

== 5. Sincronización Global de Clientes ==

StompBroker -> View: Mensaje en /topic/tilesAndSalmons/{matchId}
StompBroker -> RemoteClients: Mensaje en /topic/tilesAndSalmons/{matchId}

View -> View: Sincronizar cuadrícula y renderizar nuevo estado
RemoteClients -> RemoteClients: Sincronizar cuadrícula y renderizar nuevo estado

@enduml

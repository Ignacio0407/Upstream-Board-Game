@startuml
skinparam shadowing false
skinparam packageStyle rectangle

title Arquitectura de Sistema y Flujo de Datos

actor "Jugador (Navegador)" as User

package "Frontend (React + Vite)" #E3F2FD {
    component "UI Components" as UI
    component "Game Engine (Client)" as Engine
    component "WebSocket Manager" as WSClient
}

package "Backend (Spring Boot)" #F1F8E9 {
    package "Capa de Seguridad" #FFEB3B {
        component "JWT Filter" as JWT
        component "WS Security Interceptor" as WSAuth
    }
    
    package "Capa de Control (API)" #C8E6C9 {
        component "REST Controllers" as REST
        component "STOMP Message Broker" as Broker
    }
    
    package "Capa de Servicio (Lógica)" #A5D6A7 {
        component "MatchService" as MatchS
        component "SalmonMatchService" as SalmonS
        component "Achievement Engine" as Achievement
    }
}

database "Persistencia (H2 / PostgreSQL)" #FFF9C4 {
    storage "Entidades JPA" as DB
}

' Flujos de comunicación
User <--> UI : Interacción
UI --> REST : Peticiones HTTP (Login, Join)
REST --> JWT : Valida Token
WSClient <--> Broker : Full-Duplex (STOMP)
Broker --> WSAuth : Autoriza Canal/Acción

REST --> MatchS
Broker --> MatchS
MatchS --> DB : CRUD
SalmonS --> DB
Achievement --> DB

note bottom of UI
  Tecnologías: React 18, 
  TypeScript, Ant Design
end note

note bottom of Broker
  Real-time: STOMP sobre 
  SockJS para máxima compatibilidad
end note
@enduml

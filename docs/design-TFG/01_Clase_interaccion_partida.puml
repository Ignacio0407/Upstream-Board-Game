@startuml
skinparam shadowing false
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #2C3E50
    ArrowColor #2C3E50
}

title Modelo de Dominio JPA - Núcleo de Partida y Entidades

abstract class BaseEntity {
    - Integer id
    + Integer getId()
    + void setId(Integer id)
    + boolean isNew()
}

abstract class NamedEntity extends BaseEntity {
    - String name
    + String getName()
    + void setName(String name)
}

enum State <<enumeration>> {
    WAITING
    ON_GOING
    FINALIZED
}

enum Phase <<enumeration>> {
    TILES
    MOVING
}

enum Color <<enumeration>> {
    RED
    BLUE
    YELLOW
    GREEN
    PURPLE
}

enum TileType <<enumeration>> {
    WATER
    ROCK
    BEAR
    EAGLE
    HERON
    JUMP
    SPAWN
}

enum Authority <<enumeration>> {
    ADMIN
    PLAYER
}

class Coordinate <<Embeddable>> {
    - Integer x
    - Integer y
    + Integer x()
    + Integer y()
}

class User extends NamedEntity {
    - String password
    - Authority authority
    - Integer victories
    - Integer playedgames
    - Integer totalpoints
}

class Match extends NamedEntity {
    - String password
    - State state
    - Integer playersNumber
    - Integer round
    - Phase phase
    - Boolean finalScoreCalculated
}

class Player extends BaseEntity {
    - String name
    - Color color
    - Integer playerOrder
    - Boolean alive
    - Integer points
    - Integer energy
}

class Salmon extends BaseEntity {
    - Color color
    - String image
}

class Tile extends BaseEntity {
    - String image
    - TileType type
}

class SalmonMatch extends BaseEntity {
    - Integer salmonsNumber
    - Integer spawningNumber
    - Coordinate coordinate
}

class MatchTile extends BaseEntity {
    - Integer capacity
    - Integer orientation
    - Integer salmonsNumber
    - Coordinate coordinate
    + boolean isFull()
}

class Message extends BaseEntity {
    - String content
    - LocalDateTime createdAt
}

' Relaciones del Dominio
Match "1" *-- "2..5" Player : players
Match "1" *-- "*" MatchTile : game
Match "1" *-- "*" SalmonMatch : game
Match "1" -- "0..1" Player : initialPlayer
Match "1" -- "0..1" Player : actualPlayer
Match "*" -- "1" User : matchCreator

User "1" -- "1" Authority : authority
Player "*" -- "1" User : userPlayer
Player "1" -- "*" SalmonMatch : owner
Player "1" -- "*" Message : author

SalmonMatch "*" -- "1" Salmon : salmonDefinition
MatchTile "*" -- "1" Tile : tileDefinition

SalmonMatch *-- "0..1" Coordinate : coordinate
MatchTile *-- "0..1" Coordinate : coordinate
Message "*" -- "1" Match : match

note bottom of Match
  Centraliza el ciclo y las reglas de la partida.
  Las referencias initialPlayer y actualPlayer
  coordinan el orden de turnos en cada ronda.
end note

note right of SalmonMatch
  Representa el estado dinámico de cada grupo
  de salmones (mar, río o desove).
end note

@enduml
